/*
 * PATCH /api/admin/services/:id
 */
router.patch('/services/:id', authenticateAdminToken, async (req, res) => {
  const serviceId = Number(req.params.id);

  if (!Number.isSafeInteger(serviceId) || serviceId < 1) {
    return res.status(400).json({
      success: false,
      message: 'Invalid service ID.'
    });
  }

  if (typeof req.body.enabled !== 'boolean') {
    return res.status(400).json({
      success: false,
      message: 'enabled must be true or false.'
    });
  }

  try {
    const [result] = await pool.execute(
      `UPDATE services
       SET is_enabled = ?
       WHERE id = ?`,
      [req.body.enabled ? 1 : 0, serviceId]
    );

    if (!result.affectedRows) {
      return res.status(404).json({
        success: false,
        message: 'Service not found.'
      });
    }

    return res.json({
      success: true,
      message: 'Service status updated successfully.'
    });
  } catch (error) {
    console.error('Service update failed:', error.message);

    return res.status(500).json({
      success: false,
      message: 'Could not update service.'
    });
  }
});

