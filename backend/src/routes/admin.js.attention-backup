  } catch (error) {
    console.error('Admin profile lookup failed:', error.message);

    return res.status(500).json({
      success: false,
      message: 'Could not retrieve admin profile.'
    });
  }
});

/*
 * GET /api/admin/dashboard
 */
router.get('/dashboard', authenticateAdminToken, async (req, res) => {
  try {
    const [
      [userRows],
      [walletRows],
      [transactionRows],
      [successfulRows],
      [pendingRows]
    ] = await Promise.all([
      pool.execute(
        `SELECT COUNT(*) AS total
         FROM users`
      ),
      pool.execute(
        `SELECT COALESCE(SUM(balance), 0) AS total
         FROM wallets
         WHERE status = 'active'`
      ),
      pool.execute(
        `SELECT
           (
             (SELECT COUNT(*) FROM wallet_transactions) +
             (SELECT COUNT(*) FROM airtime_transactions) +
             (SELECT COUNT(*) FROM data_transactions) +
             (SELECT COUNT(*) FROM school_fee_transactions)
           ) AS total`
      ),
      pool.execute(
        `SELECT
           (
             (SELECT COUNT(*) FROM wallet_transactions WHERE status = 'successful') +
             (SELECT COUNT(*) FROM airtime_transactions WHERE status = 'successful') +
             (SELECT COUNT(*) FROM data_transactions WHERE status = 'successful') +
             (SELECT COUNT(*) FROM school_fee_transactions WHERE status = 'successful')
           ) AS total`
      ),
      pool.execute(
        `SELECT
           (
             (SELECT COUNT(*) FROM wallet_transactions WHERE status = 'pending') +
             (SELECT COUNT(*) FROM airtime_transactions WHERE status = 'pending') +
             (SELECT COUNT(*) FROM data_transactions WHERE status = 'pending') +
             (SELECT COUNT(*) FROM school_fee_transactions WHERE status = 'pending')
           ) AS total`
      )
    ]);

    const totalTransactions = Number(transactionRows[0].total);
    const successfulTransactions = Number(successfulRows[0].total);

    return res.json({
      success: true,
      dashboard: {
        totalUsers: Number(userRows[0].total),
        walletBalance: Number(walletRows[0].total),
        totalTransactions,
        successfulTransactions,
        pendingTransactions: Number(pendingRows[0].total),
        successRate: totalTransactions
          ? Number(((successfulTransactions / totalTransactions) * 100).toFixed(1))
          : 0
      }
    });
  } catch (error) {
    console.error('Admin dashboard failed:', error.message);

    return res.status(500).json({
      success: false,
      message: 'Could not retrieve dashboard data.'
    });
  }
});

/*
 * GET /api/admin/users
 */
router.get('/users', authenticateAdminToken, async (req, res) => {
  try {
    const search = String(req.query.search || '').trim();
    const status = String(req.query.status || 'all').trim().toLowerCase();

    let sql = `
      SELECT
        u.id,
        u.full_name,
        u.email,
        u.phone,
        u.status,
        u.created_at,
        COALESCE(w.balance, 0) AS wallet_balance
      FROM users u
      LEFT JOIN wallets w ON w.user_id = u.id
      WHERE 1 = 1
    `;

    const params = [];

    if (search) {
      sql += `
        AND (
          u.full_name LIKE ?
          OR u.email LIKE ?
          OR u.phone LIKE ?
        )
      `;

      const value = `%${search}%`;
      params.push(value, value, value);
    }

    if (['active', 'suspended', 'pending'].includes(status)) {
      sql += ` AND u.status = ?`;
      params.push(status);
    }

    sql += ` ORDER BY u.created_at DESC LIMIT 500`;

    const [rows] = await pool.execute(sql, params);

    return res.json({
      success: true,
      users: rows.map(row => ({
        id: row.id,
        name: row.full_name,
        email: row.email,
        phone: row.phone,
        joined: row.created_at,
        wallet: Number(row.wallet_balance),
        status: row.status
      }))
    });
  } catch (error) {
    console.error('Admin users lookup failed:', error.message);

    return res.status(500).json({
      success: false,
      message: 'Could not retrieve users.'
    });
  }
});

/*
 * PATCH /api/admin/users/:id/status
 */
router.patch('/users/:id/status', authenticateAdminToken, async (req, res) => {
  const userId = Number(req.params.id);
  const status = String(req.body.status || '').trim().toLowerCase();

  if (!Number.isSafeInteger(userId) || userId < 1) {
    return res.status(400).json({
      success: false,
      message: 'Invalid user ID.'
    });
  }

  if (!['active', 'suspended', 'pending'].includes(status)) {
    return res.status(400).json({
      success: false,
      message: 'Invalid user status.'
    });
  }

  try {
    const [result] = await pool.execute(
      `UPDATE users
       SET status = ?
       WHERE id = ?`,
      [status, userId]
    );

    if (!result.affectedRows) {
      return res.status(404).json({
        success: false,
        message: 'User not found.'
      });
    }

    return res.json({
      success: true,
      message: 'User status updated successfully.'
    });
  } catch (error) {
    console.error('User status update failed:', error.message);

    return res.status(500).json({
      success: false,
      message: 'Could not update user status.'
    });
  }
});

/*
 * GET /api/admin/transactions
 */
router.get('/transactions', authenticateAdminToken, async (req, res) => {
  try {
    const search = String(req.query.search || '').trim();
    const status = String(req.query.status || 'all').trim().toLowerCase();

    let sql = `
      SELECT *
      FROM (
        SELECT
          wt.reference,
          u.full_name AS user_name,
          'Wallet Funding' AS service,
          wt.amount,
          wt.status,
          wt.created_at
        FROM wallet_transactions wt
        INNER JOIN users u ON u.id = wt.user_id

        UNION ALL

        SELECT
          at.our_reference AS reference,
          u.full_name AS user_name,
          'Airtime' AS service,
          at.amount,
          at.status,
          at.created_at
        FROM airtime_transactions at
        INNER JOIN users u ON u.id = at.user_id

        UNION ALL

        SELECT
          dt.our_reference AS reference,
          u.full_name AS user_name,
          'Data' AS service,
          dt.amount,
          dt.status,
          dt.created_at
        FROM data_transactions dt
        INNER JOIN users u ON u.id = dt.user_id

        UNION ALL

        SELECT
          sf.our_reference AS reference,
          u.full_name AS user_name,
          'School Fees' AS service,
          sf.amount,
          sf.status,
          sf.created_at
        FROM school_fee_transactions sf
        INNER JOIN users u ON u.id = sf.user_id
      ) AS tx
      WHERE 1 = 1
    `;

    const params = [];

    if (search) {
      sql += `
        AND (
          reference LIKE ?
          OR user_name LIKE ?
          OR service LIKE ?
        )
      `;

      const value = `%${search}%`;
      params.push(value, value, value);
    }

    if (['pending', 'successful', 'failed', 'refunded', 'reversed'].includes(status)) {
      sql += ` AND status = ?`;
      params.push(status);
    }

    sql += ` ORDER BY created_at DESC LIMIT 500`;

    const [rows] = await pool.execute(sql, params);

    return res.json({
      success: true,
      transactions: rows.map(row => ({
        ref: row.reference,
        user: row.user_name,
        service: row.service,
        amount: Number(row.amount),
        date: row.created_at,
        status: row.status
      }))
    });
  } catch (error) {
    console.error('Admin transactions lookup failed:', error.message);

    return res.status(500).json({
      success: false,
      message: 'Could not retrieve transactions.'
    });
  }
});



/*
 * GET /api/admin/analytics
 * Successful Airtime, Data and School Fees only.
 */
router.get('/analytics', authenticateAdminToken, async (req, res) => {
  try {
    const [rows] = await pool.execute(`
      SELECT
        (SELECT COUNT(*) FROM users) AS total_users,
        (SELECT COUNT(*) FROM users WHERE status = 'active') AS active_users,
        ((SELECT COUNT(*) FROM airtime_transactions) +
         (SELECT COUNT(*) FROM data_transactions) +
         (SELECT COUNT(*) FROM school_fee_transactions)) AS total_transactions,
        ((SELECT COUNT(*) FROM airtime_transactions WHERE status = 'successful') +
         (SELECT COUNT(*) FROM data_transactions WHERE status = 'successful') +
         (SELECT COUNT(*) FROM school_fee_transactions WHERE status = 'successful')) AS successful_transactions,
        ((SELECT COALESCE(SUM(amount),0) FROM airtime_transactions WHERE status = 'successful') +
         (SELECT COALESCE(SUM(amount),0) FROM data_transactions WHERE status = 'successful') +
         (SELECT COALESCE(SUM(amount),0) FROM school_fee_transactions WHERE status = 'successful')) AS total_service_volume,
        (SELECT COALESCE(SUM(amount),0) FROM data_transactions WHERE status = 'successful') AS data_volume,
        (SELECT COALESCE(SUM(amount),0) FROM airtime_transactions WHERE status = 'successful') AS airtime_volume,
        (SELECT COALESCE(SUM(amount),0) FROM school_fee_transactions WHERE status = 'successful') AS school_fees_volume
    `);

    const r = rows[0];
    const totalUsers = Number(r.total_users || 0);
    const activeUsers = Number(r.active_users || 0);
    const totalTransactions = Number(r.total_transactions || 0);
    const successfulTransactions = Number(r.successful_transactions || 0);
    const totalServiceVolume = Number(r.total_service_volume || 0);
    const dataVolume = Number(r.data_volume || 0);
    const airtimeVolume = Number(r.airtime_volume || 0);
    const schoolFeesVolume = Number(r.school_fees_volume || 0);
    const pct = (n, total) => total ? Number((n * 100 / total).toFixed(1)) : 0;

    return res.json({
      success: true,
      analytics: {
        totalUsers,
        activeUsers,
        activeUserRate: pct(activeUsers, totalUsers),
        totalTransactions,
        successfulTransactions,
        successRate: pct(successfulTransactions, totalTransactions),
        totalServiceVolume,
        services: [
          {key:'data', label:'Data', volume:dataVolume, percentage:pct(dataVolume,totalServiceVolume)},
          {key:'airtime', label:'Airtime', volume:airtimeVolume, percentage:pct(airtimeVolume,totalServiceVolume)},
          {key:'school-fees', label:'School Fees', volume:schoolFeesVolume, percentage:pct(schoolFeesVolume,totalServiceVolume)}
        ]
      }
    });
  } catch (error) {
    console.error('Admin analytics lookup failed:', error.message);
    return res.status(500).json({
      success: false,
      message: 'Could not retrieve report analytics.'
    });
  }
});

/*
 * GET /api/admin/wallet-stats
 */
router.get('/wallet-stats', authenticateAdminToken, async (req, res) => {
  try {
    const [rows] = await pool.execute(
      `SELECT
         (SELECT COALESCE(SUM(balance), 0)
          FROM wallets) AS total_wallet_balance,

         (SELECT COALESCE(SUM(amount), 0)
          FROM wallet_transactions
          WHERE type = 'funding'
            AND status = 'successful'
            AND created_at >= CURDATE()
            AND created_at < CURDATE() + INTERVAL 1 DAY
         ) AS today_funding,

         (SELECT COUNT(*)
          FROM wallet_transactions
          WHERE type = 'funding'
            AND status = 'successful'
            AND created_at >= CURDATE()
            AND created_at < CURDATE() + INTERVAL 1 DAY
         ) AS today_funding_count,

         (SELECT COALESCE(SUM(amount), 0)
          FROM wallet_transactions
          WHERE type = 'purchase'
            AND status = 'successful'
            AND created_at >= CURDATE()
            AND created_at < CURDATE() + INTERVAL 1 DAY
         ) AS today_spending,

         (SELECT COALESCE(SUM(amount), 0)
          FROM refunds
          WHERE status = 'pending'
         ) AS pending_refund_amount,

         (SELECT COUNT(*)
          FROM refunds
          WHERE status = 'pending'
         ) AS pending_refund_count`
    );

    const row = rows[0];

    return res.json({
      success: true,
      stats: {
        totalWalletBalance: Number(row.total_wallet_balance),
        todayFunding: Number(row.today_funding),
        todayFundingCount: Number(row.today_funding_count),
        todaySpending: Number(row.today_spending),
        pendingRefundAmount: Number(row.pending_refund_amount),
        pendingRefundCount: Number(row.pending_refund_count)
      }
    });
  } catch (error) {
    console.error('Admin wallet statistics lookup failed:', error.message);
    return res.status(500).json({
      success: false,
      message: 'Could not retrieve wallet statistics.'
    });
  }
});

